# Server-only template. NEVER paste real credentials into chat or commit an .env file.
# Initial production variables have been entered directly in Vercel; do not pull them locally.
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_MERCHANT_ID=
# SHA webhook scheme only. These are separate from the PhonePe OAuth credentials.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
PAYMENT_SITE_ORIGIN=https://kkarn.vercel.app
# Restricted PostgreSQL role: portfolio_payments_api. No ssl query parameters.
DATABASE_URL=
# Optional provider CA certificate for verified TLS (never disable verification).
DATABASE_CA_CERT=
PAYMENT_SESSION_SECRET=
PAYMENT_RECONCILIATION_SECRET=
# Integer paise bounds agreed by the owner; left unset so project payments fail closed.
PROJECT_MIN_PAISE=
PROJECT_MAX_PAISE=
PAYMENTS_ENABLED=false
# Only change after UAT, worker setup, review and explicit go-live approval.
PAYMENT_RELEASE_APPROVED=false
# Community benefits/delivery are undecided; never enable before they are defined.
COMMUNITY_PAYMENTS_ENABLED=false
